{
  "manifest_version": 3,
  "name": "Free Image to Video: Animate Any Photo",
  "short_name": "Free Image to Video",
  "version": "1.0.0",
  "description": "Right-click any image to turn it into a video clip with sound on Free Image to Video. Runs on your freeimagetovideo.ai API key.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus", "storage", "notifications", "alarms"],
  "host_permissions": ["https://freeimagetovideo.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Free Image to Video",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "homepage_url": "https://freeimagetovideo.ai/?utm_source=chrome&utm_medium=extension",
  "minimum_chrome_version": "127"
}
